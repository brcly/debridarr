# Debridarr listens on 0.0.0.0; Compose publishes this port on the host too.
PORT=7000
APP_URL=http://localhost:7000
# Required: choose your own password. No default password is supplied.
ADMIN_PASSWORD=
# Local development defaults to ./data. Compose uses /app/data in a named volume.
# DATA_DIR=/absolute/path/to/data

# Imported ONLY when settings.json does not exist. Edit in /configure after setup.
# Leave blank to configure connections through the website.
# Use addresses reachable from the Debridarr container, not localhost.
PROWLARR_URL=
PROWLARR_API_KEY=
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Metadata provider used to turn Stremio ids into search terms.
# METADATA_PROVIDER: cinemeta (default, no key) or tmdb (needs a v3 API key).
# Also seeds settings.json once; change it later in /configure.
METADATA_PROVIDER=cinemeta
TMDB_API_KEY=

# Where Debridarr sees qBittorrent's completed downloads (mount it in compose).
# Use the same path qBittorrent uses, or point this at where it lands here.
DOWNLOAD_DIR=/downloads
