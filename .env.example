# Required: the address used by your browser and Stremio devices.
APP_URL=http://your-server:7000
# Required: choose a strong password of at least 12 characters for the configuration website.
ADMIN_PASSWORD=
# Required for Docker: existing host folder containing complete AND incomplete downloads.
QBITTORRENT_DOWNLOADS_DIR=/path/to/qbittorrent/downloads

# Optional deployment settings.
PORT=7000
# Match qBittorrent's internal path where possible (for example /data/torrents).
DOWNLOAD_DIR=/downloads
# Pin a published release tag here when installing a specific version.
# DEBRIDARR_IMAGE=ghcr.io/brcly/debridarr:latest
# Local development only; Docker persists configuration in a named volume.
# DATA_DIR=/absolute/path/to/data
# Set this if a reverse proxy sits in front, so login throttling and rate
# limits identify real clients instead of the proxy. Use the narrowest value
# that covers it: an address, a CIDR range, or `loopback` / `private`.
# Leaving it unset ignores X-Forwarded-For entirely, which is the safe default.
# TRUSTED_PROXIES=loopback

# Service connections, operating mode, filters and retention are configured in
# the setup guide. No service credentials are required in this file.
# Automated installs can explicitly add supported first-run seed variables
# to Compose's environment section; see docs/configuration.md.
