# Debridarr — paste into this stack's Environment tab in OMV Compose.
# Keep real credentials out of this example and the YAML.

# Set this to the image published by your GitHub repository (lowercase).
# For a repository named OWNER/debridarr: ghcr.io/owner/debridarr:latest
# Assumes the new GitHub repository will be brcly/debridarr.
DEBRIDARR_IMAGE=ghcr.io/brcly/debridarr:latest

# Choose your own password. Single quotes keep $ characters literal.
ADMIN_PASSWORD=''

# Use LAN access until the reverse proxy is ready.
APP_URL=http://10.0.0.10:7000
DEBRIDARR_PORT=7000

# Once NGINX Proxy Manager has working DNS/TLS for this hostname, replace APP_URL:
# APP_URL=https://debridarr.nexusvau.lt

# Service URLs are already in the YAML. Enter Prowlarr/qBittorrent credentials
# through Debridarr's Connections tab after first startup.
